import { bottomFor } from '../navConfig'

// Dolny pasek nawigacji (tylko telefon): najczęstsze zakładki + otwarcie pełnego menu
export default function BottomBar({ role, activeTab, setActiveTab, onMenu }: {
  role?: string
  activeTab: string
  setActiveTab: (tab: string) => void
  onMenu: () => void
}) {
  const items = bottomFor(role)
  const btn = 'flex flex-1 flex-col items-center gap-0.5 rounded-2xl py-2 text-[11px] font-bold transition-all duration-200 active:scale-95'

  return (
    <nav
      aria-label="Nawigacja dolna"
      className="fixed inset-x-0 bottom-0 z-20 flex gap-1 border-t border-white/10 bg-zinc-900/95 px-2 pt-2 backdrop-blur-xl md:hidden"
      style={{ paddingBottom: 'calc(0.5rem + env(safe-area-inset-bottom))' }}
    >
      {items.map(it => {
        const on = activeTab === it.tab
        return (
          <button key={it.tab} onClick={() => setActiveTab(it.tab)} className={`${btn} ${on ? 'bg-emerald-500/15 text-emerald-400' : 'text-zinc-400'}`}>
            <span className="text-xl">{it.icon}</span>
            {it.label}
          </button>
        )
      })}
      <button onClick={onMenu} className={`${btn} text-zinc-400`}>
        <span className="text-xl">☰</span>
        Menu
      </button>
    </nav>
  )
}

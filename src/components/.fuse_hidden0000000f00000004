import { ambientBlobs } from '../ui'
import Stepper from './Stepper'

// Wspólny szkielet ekranów logowania, rejestracji i ankiety
export default function AuthShell({ title, subtitle, children, wide = false, step, labels }: {
  title: string
  subtitle?: string
  children: React.ReactNode
  wide?: boolean
  step?: number
  labels?: string[]
}) {
  return (
    <div className="relative flex min-h-screen items-center justify-center overflow-hidden bg-zinc-950 p-4 py-8 text-white md:p-6">
      {ambientBlobs.map((cls, i) => <div key={i} className={cls} />)}

      <div className={`relative z-10 flex w-full flex-col gap-8 animate-fade-in ${wide ? 'max-w-2xl' : 'max-w-md'}`}>
        {step && labels && <Stepper step={step} labels={labels} />}

        <div className="flex flex-col items-center gap-3 text-center">
          <div className="flex h-16 w-16 items-center justify-center rounded-3xl bg-emerald-500 text-3xl shadow-lg shadow-emerald-500/25">
            🏋️
          </div>
          <h1 className="text-3xl font-extrabold tracking-tight text-white md:text-4xl">{title}</h1>
          {subtitle && <p className="text-zinc-400">{subtitle}</p>}
        </div>

        {children}
      </div>
    </div>
  )
}

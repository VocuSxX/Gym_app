import { useState, useEffect } from 'react'
import { supabase } from '../../supabaseClient'
import { btnPrimarySm, btnGhost, inputBase } from '../../ui'
import Banner from '../Banner'
import { emptyCard, type IntakeCard, type IntakeSnapshot, type Question } from '../../intake'

const pill = (on: boolean) =>
  `rounded-full border px-4 py-2 text-sm font-bold transition-all duration-200 active:scale-95 ${on ? 'border-emerald-500/40 bg-emerald-500/15 text-emerald-400' : 'border-white/10 bg-white/5 text-zinc-400 hover:bg-white/10 hover:text-white'}`

// Zaproszenie do trenera: karta ćwiczącego (zapamiętywana), pytania trenera i wiadomość powitalna
export default function InviteModal({ userId, trainer, onClose, onSubmit }: {
  userId: string
  trainer: { id: string; nickname: string }
  onClose: () => void
  onSubmit: (message: string, intake: IntakeSnapshot) => Promise<boolean>
}) {
  const [card, setCard] = useState<IntakeCard>(emptyCard)
  const [questions, setQuestions] = useState<Question[]>([])
  const [answers, setAnswers] = useState<Record<string, string>>({})
  const [message, setMessage] = useState('')
  const [loading, setLoading] = useState(true)
  const [sending, setSending] = useState(false)
  const [error, setError] = useState('')

  useEffect(() => {
    const load = async () => {
      const [{ data: c }, { data: q }] = await Promise.all([
        supabase.from('client_intake').select('goal, injuries, sessions_per_week').eq('user_id', userId).maybeSingle(),
        supabase.from('trainer_questions').select('*').eq('trainer_id', trainer.id).order('order_index', { ascending: true }),
      ])
      if (c) setCard({ goal: c.goal || '', injuries: c.injuries || '', sessions_per_week: c.sessions_per_week ?? null })
      setQuestions((q || []) as Question[])
      setLoading(false)
    }
    load()
  }, [userId, trainer.id])

  useEffect(() => {
    const onKey = (e: KeyboardEvent) => { if (e.key === 'Escape' && !sending) onClose() }
    window.addEventListener('keydown', onKey)
    return () => window.removeEventListener('keydown', onKey)
  }, [onClose, sending])

  const setAnswer = (id: string, value: string) => setAnswers(a => ({ ...a, [id]: value }))

  const submit = async (e: React.FormEvent) => {
    e.preventDefault()
    const missing = questions.find(q => q.is_required && !(answers[q.id] || '').trim())
    if (missing) return setError(`Odpowiedz na pytanie: „${missing.question}”`)
    setError('')
    setSending(true)

    // Karta zapisuje się na przyszłość (błąd zapisu nie blokuje zaproszenia)
    await supabase.from('client_intake').upsert(
      { user_id: userId, goal: card.goal.trim(), injuries: card.injuries.trim(), sessions_per_week: card.sessions_per_week, updated_at: new Date().toISOString() },
      { onConflict: 'user_id' },
    )

    const snapshot: IntakeSnapshot = {
      card: { goal: card.goal.trim(), injuries: card.injuries.trim(), sessions_per_week: card.sessions_per_week },
      answers: questions.map(q => ({ question: q.question, answer: (answers[q.id] || '').trim() })),
    }
    const ok = await onSubmit(message.trim(), snapshot)
    setSending(false)
    if (ok) onClose()
  }

  return (
    <div className="fixed inset-0 z-[90] flex items-end justify-center bg-black/60 backdrop-blur-sm animate-fade-in sm:items-center sm:p-4" onClick={() => !sending && onClose()}>
      <form
        onSubmit={submit}
        role="dialog"
        aria-modal="true"
        aria-label={`Zaproszenie do @${trainer.nickname}`}
        className="flex max-h-[92vh] w-full max-w-lg flex-col gap-6 overflow-y-auto rounded-t-3xl border border-white/10 bg-zinc-900 p-6 shadow-2xl sm:rounded-3xl"
        onClick={e => e.stopPropagation()}
      >
        <div className="flex items-center justify-between">
          <h3 className="text-xl font-extrabold text-white">🤝 Zaproszenie do @{trainer.nickname}</h3>
          <button type="button" onClick={onClose} disabled={sending} className="flex h-9 w-9 items-center justify-center rounded-xl bg-white/5 text-zinc-400 transition-colors hover:text-white" aria-label="Zamknij">✕</button>
        </div>

        {loading ? (
          <p className="animate-pulse text-center font-bold text-zinc-400">Ładowanie...</p>
        ) : (
          <>
            <section className="flex flex-col gap-4">
              <p className="text-xs font-bold uppercase tracking-widest text-emerald-400">Twoja karta ćwiczącego</p>
              <input type="text" value={card.goal} onChange={e => setCard({ ...card, goal: e.target.value })} placeholder="Twój cel, np. redukcja 5 kg do wakacji" className={inputBase} />
              <textarea value={card.injuries} onChange={e => setCard({ ...card, injuries: e.target.value })} placeholder="Kontuzje i ograniczenia (opcjonalnie)" className={`${inputBase} h-20 resize-none`} />
              <div className="flex items-center gap-3">
                <label className="text-sm font-bold text-zinc-400">Treningów w tygodniu</label>
                <input
                  type="number" min={1} max={14}
                  value={card.sessions_per_week ?? ''}
                  onChange={e => setCard({ ...card, sessions_per_week: e.target.value ? Math.min(14, Math.max(1, Number(e.target.value))) : null })}
                  className={`${inputBase} !w-24`}
                />
              </div>
              <p className="text-xs text-zinc-400">Zapamiętamy ją, więc przy kolejnych zaproszeniach będzie już uzupełniona.</p>
            </section>

            {questions.length > 0 && (
              <section className="flex flex-col gap-5">
                <p className="text-xs font-bold uppercase tracking-widest text-emerald-400">Pytania od trenera</p>
                {questions.map(q => (
                  <div key={q.id} className="flex flex-col gap-2">
                    <label className="font-bold text-white">{q.question}{q.is_required && <span className="text-emerald-400"> *</span>}</label>
                    {q.q_type === 'text' && (
                      <textarea value={answers[q.id] || ''} onChange={e => setAnswer(q.id, e.target.value)} className={`${inputBase} h-20 resize-none`} />
                    )}
                    {q.q_type === 'yesno' && (
                      <div className="flex gap-2">
                        {['Tak', 'Nie'].map(o => (
                          <button key={o} type="button" onClick={() => setAnswer(q.id, o)} className={pill(answers[q.id] === o)}>{o}</button>
                        ))}
                      </div>
                    )}
                    {q.q_type === 'choice' && (
                      <div className="flex flex-wrap gap-2">
                        {q.options.map(o => (
                          <button key={o} type="button" onClick={() => setAnswer(q.id, o)} className={pill(answers[q.id] === o)}>{o}</button>
                        ))}
                      </div>
                    )}
                  </div>
                ))}
              </section>
            )}

            <section className="flex flex-col gap-3">
              <p className="text-xs font-bold uppercase tracking-widest text-emerald-400">Wiadomość powitalna</p>
              <textarea value={message} onChange={e => setMessage(e.target.value)} placeholder="Kim jesteś, czego oczekujesz..." className={`${inputBase} h-24 resize-none`} />
            </section>

            <Banner type="error" message={error} />

            <div className="flex gap-3">
              <button type="button" onClick={onClose} disabled={sending} className={`${btnGhost} flex-1`}>Anuluj</button>
              <button type="submit" disabled={sending} className={`${btnPrimarySm} flex-1 disabled:opacity-50 disabled:pointer-events-none`}>
                {sending ? 'Wysyłanie...' : 'Wyślij zaproszenie'}
              </button>
            </div>
          </>
        )}
      </form>
    </div>
  )
}
